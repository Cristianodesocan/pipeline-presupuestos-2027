# Copia este fichero como .env (está en .gitignore) y rellena los valores. Nunca subas .env al repositorio.
# Mismos nombres de variable que Canarias en Datos.

# Cadena de conexión PostgreSQL del proyecto bd_odesocan (Supabase → Project Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SCHEMA=presupuestos_can
